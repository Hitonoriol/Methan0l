include_guard(GLOBAL)

function(methan0l_bootstrap_module)
	if(NOT CMAKE_SOURCE_DIR STREQUAL CMAKE_CURRENT_SOURCE_DIR)
		return()
	endif()

	get_filename_component(METHAN0L_MODULE_SOURCE_DIR
		"${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)

	set(METHAN0L_BUILD_MODULES OFF CACHE BOOL "" FORCE)
	add_subdirectory("${METHAN0L_MODULE_SOURCE_DIR}" methan0l EXCLUDE_FROM_ALL)
	add_custom_target(modules)

	set(METHAN0L_SOURCE_DIR "${METHAN0L_MODULE_SOURCE_DIR}" PARENT_SCOPE)
	set(METHAN0L_RUNTIME_DIR "${CMAKE_BINARY_DIR}/runtime/$<CONFIG>" PARENT_SCOPE)
	set(METHAN0L_ARCHIVE_DIR "${CMAKE_BINARY_DIR}/lib/$<CONFIG>" PARENT_SCOPE)
	math(EXPR METHAN0L_MODULE_BITS "${CMAKE_SIZEOF_VOID_P} * 8")
	set(METHAN0L_BITS "${METHAN0L_MODULE_BITS}" PARENT_SCOPE)
endfunction()
