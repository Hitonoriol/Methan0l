/* Adapted from gist.github.com/rexim/c595009436f87ca076e7c4a2fb92ce10 */
rule110 = fun: size => 50 {
	chars = " *"
	board = [].fill(0, size)

	board[size - 2] = 1

	i = 0
	while: (i < size - 2) {
		j = 0
		while: (j < size) {
			%% chars[board[j]]
			++j
		}
		%% '\n'

		pattern = (board[0] << 1) | board[1]
		j = 1
		while: (j < size - 1) {
			pattern = ((pattern << 1) & 7) | board[j + 1]
			board[j] = (110 >> pattern) & 1
			++j
		}
		++i
	}
}

if: (is_main_unit()) {
	rule110()
}
