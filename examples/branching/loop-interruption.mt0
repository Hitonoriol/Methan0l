/* Yep. This only became a feature on Apr 13 '22. */

f = fun: () {
	/* Break from while loop */
	i = 0
	while: (i < 100) {
		i > 5 ? return: break
		<% $"i = {}" i
		++i
	}
	
	/* Break from while loop */
	x = 100
	while: (x > 0) {
		%% --x
		if: (x < 91) {
			%% newl
			return: break
		} else: {
			%% " "
		}
	}
	
	/* Return from while loop */
	i = 0
	while: (i < 100) {
		if: (i == 10) {
			return: 123
		}
		<% $"I drank {} bottles o' moonshine" i
		++i
	}
	<% "Unreachable"
}

<% "Function return value: " :: f()
