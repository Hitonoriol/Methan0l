<% "Loops" :: newl

<% "While loop"
i = 1
while: (i < 100) {
	%% i :: " "
	if: (i % 10 == 0)
		%% newl
	++i
}
<% newl

<% "Functional iteration (works for any Iterable)"
some_list = ["first element", 999, -0.123456, false, -1, false, true, "another element", 1337]
<% "List: " :: some_list
some_list.for_each(f: elem {
	%% "* " :: elem :: " "
	if: (elem is: String)
		<% "(Length: " :: elem.size() :: ")"
	else: if: ((elem is: Int) || (elem is: Float))
		<% "is positive: " :: (elem > 0)
	else:
		<% "is a " :: typename: elem
})
<% newl

<% "Single-expression callbacks"
["a", "b", "c", "d", "e"].for_each(f: val -> %% val :: " ")
<% newl

<% "Range iteration"
range(15).for_each(f: i -> %% i :: " ")
<% newl

<% "Another while loop"
foo = some_list.size() * 6.75
while: (foo > 50) {
	%% "<While Loop> "
	--foo
}
<% newl
