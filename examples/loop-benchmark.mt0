<% "Functional iteration benchmark (1,000,000 elements)" :: newl

set_max_mem(0x8000000)

iterations = 1_000_000
measurements = 5

mean_time = fun: action {
	total = 0.0
	i = 0
	while: (i++ < #measurements)
		total += measure_time(action())
	return: total / #measurements
}

functional = mean_time({
	(1..(#iterations + 1)).for_each(f: value { value + 1 })
})

<% "Functional for_each: " :: functional :: " ms"
