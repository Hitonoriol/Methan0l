import: "$:/modules/system"

<% "Running all examples in isolated interpreter processes" :: newl

started = now()
args = get_launch_args()
this = File@filename(args[0])
root = new: File((new: File(args[0])).parent_path())

if: (!root.exists() || !root.is_dir())
	die($"Failed to open examples directory {}" root)

candidate = new: File("")
total = passed = failed = 0

root.for_each(f: file {
	candidate.set(file)
	if: (candidate.extension() != ".mt0" || candidate.filename() == this)
		nil!

	++total
	test_started = now()
	result = run_process(get_bin_path(), candidate.absolute_path())
	elapsed = now() - test_started

	if: (result.y() == 0) {
		++passed
		<% $"PASS {} ({} ms)" candidate, elapsed
	} else: {
		++failed
		<% $"FAIL {} ({} ms, exit code {})" candidate, elapsed, result.y()
		if: (!result.x().is_empty())
			<% result.x()
	}
})

<% newl :: $"Passed: {}  Failed: {}  Total: {}" passed, failed, total
<% $"Finished in {} ms." (now() - started)

return: failed
