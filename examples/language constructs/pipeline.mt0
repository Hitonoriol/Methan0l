foo = 1..100
	|> .map(f: x -> x * 2)
	|> .filter(f: x -> x % 3 == 0)

result = foo.collect(new: List([]))
"Fail" assert: result == [6, 12, 18, 24, 30, 36, 42, 48, 54, 60, 66, 72, 78, 84, 90, 96, 102, 108, 114, 120, 126, 132, 138, 144, 150, 156, 162, 168, 174, 180, 186, 192, 198]

double = f: value -> value * 2
source_calls = 0
source = f: () -> ++source_calls, 5!
scalar = source() |> double() |> + 1
"Fail" assert: scalar == 11
